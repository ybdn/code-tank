{
  "name": "code-tank-site",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "postinstall": "nuxt prepare",
    "db:start": "supabase db start",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:stop": "supabase stop",
    "db:types": "supabase gen types --lang=typescript --local > app/types/database.types.ts",
    "stack:start": "supabase start -x studio,realtime,imgproxy,edge-runtime,logflare,vector,postgres-meta,supavisor",
    "stack:stop": "supabase stop",
    "test:stack": "nuxt build && vitest run --config vitest.stack.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@nuxtjs/supabase": "^2.1.0",
    "disposable-email-domains-js": "^2.3.0",
    "marked": "^18.2.1",
    "nodemailer": "^10.6.1",
    "nuxt": "^4.6.4",
    "nuxt-security": "^2.7.0",
    "vue": "^3.5.46",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.4.0",
    "@supabase/supabase-js": "^2.119.2",
    "@types/nodemailer": "^8.0.2",
    "eslint": "^10.15.0",
    "supabase": "^3.2.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1",
    "vue-tsc": "^3.3.14"
  },
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24"
  }
}
